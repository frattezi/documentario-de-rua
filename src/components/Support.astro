---
// The support section: the PIX card and its copy island.
// The live markup has no whitespace between tags; line breaks sit inside the tags to keep it so.
import PixCopy from "./PixCopy";
import { pixKey, support } from "../content/support";
import "../styles/support.css";
---
<section id="apoie" class="support" aria-labelledby="apoie-h"
  ><div class="wrap"
    ><span class="eyebrow">{support.eyebrow}</span><h2 class="h2" id="apoie-h">{support.heading}</h2
    ><div class="pix"
      ><div><p>{support.body}</p><span class="pending">{support.pending}</span></div><div
        class="pixcard"
        ><div class="qr">{support.qrLabel}</div><div
          ><span class="lbl">{support.keyLabel}</span><PixCopy client:visible pixKey={pixKey} /></div
        ></div
      ></div
    ></div
  ></section
>
