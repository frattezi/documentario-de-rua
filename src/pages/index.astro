---
// The site is one page (ADR 0002), in the order Spec 0002 sets: the Project is presented, its
// Stories are watched, then the visitor is asked to take part, and the Film follows.
// The markup carries no whitespace between tags, as the live build emits it.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Channel from "../components/Channel.astro";
import Participate from "../components/Participate.astro";
import Film from "../components/Film.astro";
import Voices from "../components/Voices.astro";
import Timeline from "../components/Timeline.astro";
import Law from "../components/Law.astro";
import Footer from "../components/Footer.astro";
---
<Base
  ><Header /><main
    ><Hero /><About /><Channel /><Participate /><Film /><Voices /><Timeline /><Law /></main
  ><Footer /></Base
>
